{
  "name": "@jswork/react-modal-hub",
  "version": "1.0.0",
  "description": "One hub to present, dismiss, and sync every React modal.",
  "homepage": "https://js.work",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter example dev",
    "test": "pnpm --filter @jswork/react-modal-hub test",
